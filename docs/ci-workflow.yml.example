name: Verify Max project
on: [push, pull_request]
permissions:
  contents: read
jobs:
  software:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '22'
      - run: npm run build
      - run: npm test
      - name: Generated patchers reproduce from source
        run: git diff --exit-code -- lunar-lens.maxproj code/lens_analysis.genexpr patchers/
