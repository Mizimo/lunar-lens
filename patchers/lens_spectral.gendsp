        "box": {
          "id": "code",
          "maxclass": "codebox",
          "numinlets": 5,
          "numoutlets": 55,
          "patching_rect": [
            70,
            100,
            850,
            480
          ],
          "code": "// pfft~ 2048 / overlap 4. Stereo power avoids antiphase cancellation.\n// Descriptors plus 16 L / shared-centre / R power distributions.\n// All values are latched together. This is a phase-aware estimate, not stems.\nParam hostRate(44100);\nData spatialSum(48); Data spatialFrame(48);\nData leftHistory(1024); Data rightHistory(1024); Data crossHistory(1024);\nData previous(1024);\nHistory mass(0); History moment(0); History moment2(0); History logarithms(0);\nHistory plogp(0); History squareSum(0); History oldSquareSum(0); History dot(0);\nHistory maximum(0); History count(0); History frameCount(0);\nHistory centroid(0); History spread(0); History flatness(0); History novelty(0);\nHistory concentration(0); History entropy(0);\nindex=clamp(floor(in5),0,1023);\nif(index==0){\n for(slot=0;slot<48;slot=slot+1){\n  poke(spatialFrame,peek(spatialSum,slot),slot);poke(spatialSum,0,slot);\n }\n if(count>0 && mass>0.000000000001){\n  centroid=moment/mass;\n  spread=sqrt(max(0,moment2/mass-centroid*centroid));\n  flatness=clamp(exp(logarithms/count)/(mass/count),0,1);\n  novelty=oldSquareSum>0.000000000001 ? clamp(1-dot/sqrt(max(0.000000000001,squareSum*oldSquareSum)),0,1) : 0;\n  concentration=maximum/mass;\n  entropy=clamp((log(mass)-plogp/mass)/log(max(2,count)),0,1);\n } else {centroid=0;spread=0;flatness=0;novelty=0;concentration=0;entropy=0;}\n mass=0;moment=0;moment2=0;logarithms=0;plogp=0;\n squareSum=0;oldSquareSum=0;dot=0;maximum=0;count=0;frameCount=frameCount+1;\n}\n// Ignore DC; include the entire remaining non-redundant spectrum.\npower=(in1*in1+in2*in2+in3*in3+in4*in4)*0.5;\nold=peek(previous,index); poke(previous,power,index);\nif(index>0){\n f=index/1024; mass=mass+power;moment=moment+power*f;moment2=moment2+power*f*f;\n logarithms=logarithms+log(max(0.00000000000000000001,power));\n plogp=plogp+power*log(max(0.00000000000000000001,power));\n squareSum=squareSum+power*power;oldSquareSum=oldSquareSum+old*old;dot=dot+old*power;\n maximum=max(maximum,power);count=count+1;\n}\nout1=centroid;out2=spread;out3=flatness;out4=novelty;\nout5=concentration;out6=entropy;out7=frameCount;\n\n// Smooth each complex bin's power and signed real cross-power over 80 ms.\n// Splitting BEFORE summing a frequency band retains simultaneous opposite pans.\nalpha=1-exp(-512/(max(8000,hostRate)*0.08));\nlp=peek(leftHistory,index);rp=peek(rightHistory,index);cp=peek(crossHistory,index);\nlp=lp+alpha*(in1*in1+in2*in2-lp);\nrp=rp+alpha*(in3*in3+in4*in4-rp);\ncp=cp+alpha*(in1*in3+in2*in4-cp);\npoke(leftHistory,lp,index);poke(rightHistory,rp,index);poke(crossHistory,cp,index);\ncoherence=clamp(cp/sqrt(max(0.00000000000000000001,lp*rp)),0,1);\n// \"Both channels contain energy\" is insufficient evidence of a centre image.\n// Require near-balanced power AND strongly positive, temporally averaged phase agreement.\nbalanceRatio=min(lp,rp)/max(0.00000000000000000001,max(lp,rp));\nphaseGate=clamp((coherence-0.85)/0.13,0,1);phaseGate=phaseGate*phaseGate*(3-2*phaseGate);\nlevelGate=clamp((balanceRatio-0.70)/0.25,0,1);levelGate=levelGate*levelGate*(3-2*levelGate);\ncommon=min(lp,rp)*phaseGate*levelGate;\nhz=index*hostRate/2048;\nband=hz<50 ? 0 : hz<70 ? 1 : hz<100 ? 2 : hz<140 ? 3 : hz<200 ? 4 : hz<280 ? 5 : hz<410 ? 6 : hz<600 ? 7 : hz<950 ? 8 : hz<1500 ? 9 : hz<2300 ? 10 : hz<3500 ? 11 : hz<5100 ? 12 : hz<7500 ? 13 : hz<11000 ? 14 : hz<16000 ? 15 : 16;\nif(index>0 && hz>=30 && band<16){\n slot=band*3;\n poke(spatialSum,peek(spatialSum,slot)+max(0,lp-common),slot);\n poke(spatialSum,peek(spatialSum,slot+1)+2*common,slot+1);\n poke(spatialSum,peek(spatialSum,slot+2)+max(0,rp-common),slot+2);\n}\nout8=peek(spatialFrame,0);\nout9=peek(spatialFrame,1);\nout10=peek(spatialFrame,2);\nout11=peek(spatialFrame,3);\nout12=peek(spatialFrame,4);\nout13=peek(spatialFrame,5);\nout14=peek(spatialFrame,6);\nout15=peek(spatialFrame,7);\nout16=peek(spatialFrame,8);\nout17=peek(spatialFrame,9);\nout18=peek(spatialFrame,10);\nout19=peek(spatialFrame,11);\nout20=peek(spatialFrame,12);\nout21=peek(spatialFrame,13);\nout22=peek(spatialFrame,14);\nout23=peek(spatialFrame,15);\nout24=peek(spatialFrame,16);\nout25=peek(spatialFrame,17);\nout26=peek(spatialFrame,18);\nout27=peek(spatialFrame,19);\nout28=peek(spatialFrame,20);\nout29=peek(spatialFrame,21);\nout30=peek(spatialFrame,22);\nout31=peek(spatialFrame,23);\nout32=peek(spatialFrame,24);\nout33=peek(spatialFrame,25);\nout34=peek(spatialFrame,26);\nout35=peek(spatialFrame,27);\nout36=peek(spatialFrame,28);\nout37=peek(spatialFrame,29);\nout38=peek(spatialFrame,30);\nout39=peek(spatialFrame,31);\nout40=peek(spatialFrame,32);\nout41=peek(spatialFrame,33);\nout42=peek(spatialFrame,34);\nout43=peek(spatialFrame,35);\nout44=peek(spatialFrame,36);\nout45=peek(spatialFrame,37);\nout46=peek(spatialFrame,38);\nout47=peek(spatialFrame,39);\nout48=peek(spatialFrame,40);\nout49=peek(spatialFrame,41);\nout50=peek(spatialFrame,42);\nout51=peek(spatialFrame,43);\nout52=peek(spatialFrame,44);\nout53=peek(spatialFrame,45);\nout54=peek(spatialFrame,46);\nout55=peek(spatialFrame,47);\n"
        }
