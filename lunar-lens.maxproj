{
  "name": "lunar-lens",
  "version": 1,
  "autoorganize": 0,
  "autolocalize": 0,
  "hideprojectwindow": 0,
  "contents": {
    "patchers": {
      "Lunar Lens.maxpat": {
        "kind": "patcher",
        "local": 1,
        "toplevel": 1
      },
      "lens_analysis.gendsp": {
        "kind": "patcher",
        "local": 1
      },
      "lens_context.gendsp": {
        "kind": "patcher",
        "local": 1
      },
      "lens_fx.gendsp": {
        "kind": "patcher",
        "local": 1
      },
      "lens_spectral.gendsp": {
        "kind": "patcher",
        "local": 1
      },
      "lens_spectral.maxpat": {
        "kind": "patcher",
        "local": 1
      }
    },
    "code": {
      "lens_analysis.genexpr": {
        "kind": "javascript",
        "local": 1
      },
      "lens_behaviours.js": {
        "kind": "javascript",
        "local": 1
      },
      "lens_context.genexpr": {
        "kind": "javascript",
        "local": 1
      },
      "lens_events.js": {
        "kind": "javascript",
        "local": 1
      },
      "lens_features.js": {
        "kind": "javascript",
        "local": 1
      },
      "lens_fx.genexpr": {
        "kind": "javascript",
        "local": 1
      },
      "lens_grid.js": {
        "kind": "javascript",
        "local": 1
      },
      "lens_interaction.js": {
        "kind": "javascript",
        "local": 1
      },
      "lens_measurements.js": {
        "kind": "javascript",
        "local": 1
      },
      "lens_presentation.js": {
        "kind": "javascript",
        "local": 1
      },
      "lens_protocol.js": {
        "kind": "javascript",
        "local": 1
      },
      "lens_spectral.genexpr": {
        "kind": "javascript",
        "local": 1
      },
      "lens_transition.js": {
        "kind": "javascript",
        "local": 1
      },
      "lens_ui.js": {
        "kind": "javascript",
        "local": 1
      },
      "lens_visual.js": {
        "kind": "javascript",
        "local": 1
      }
    },
    "media": {
      "Lunar-Departure-demo.wav": {
        "kind": "audiofile",
        "local": 1
      },
      "touch-feedback-demo.mp3": {
        "kind": "audiofile",
        "local": 1
      }
    }
  },
  "searchpath": {
    "code": {
      "path": "./code",
      "recursive": 1
    },
    "patchers": {
      "path": "./patchers",
      "recursive": 1
    },
    "media": {
      "path": "./media",
      "recursive": 1
    }
  },
  "layout": {},
  "devpath": ".",
  "devpathtype": 0
}